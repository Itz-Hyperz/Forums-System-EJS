<hr>
<h4>Website Data Management</h4>
<p>Purge and reset all stored data here!</p>
<p style="color: red;">WARNING: This action cannot be undone!</p>

<button type="button" data-bs-toggle="modal" data-bs-target="#confirmPurgeUsers" class="btn btn-outline-warning" style="margin-top: 0.4em; margin-left: 0.4em; margin-right: 0.4em;">Purge Users</button>
<div class="modal fade" id="confirmPurgeUsers" tabindex="-1" aria-labelledby="confirmModal" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content themefour">
        <div class="modal-header">
          <h5 class="modal-title" id="exampleModalLabel">Are you sure?</h5>
          <button type="button" class="timesbutton text-white" data-bs-dismiss="modal" aria-label="Close">&times;</button>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">Cancel</button>
          <a href="/backend/purge/users" class="btn btn-warning">Yes, I'm sure</a>
        </div>
      </div>
    </div>
</div>

