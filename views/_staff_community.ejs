<h3>Community Management</h3>
<p>Manage the default community settings here!</p>
<hr>
<form action="/backend/update/community" method="post">
    <div class="form-group">
        <label for="name">Site Logo (must end with PNG)</label>
        <input type="text" class="form-control themefour text-center defaultborderradius forumcontrol" name="sitelogo" placeholder="Enter an image url..." value="<%= d %>assets/logo.png" required>
        <br>
        <label for="name">Site Banner (must end with PNG)</label>
        <input type="text" class="form-control themefour text-center defaultborderradius forumcontrol" name="sitebanner" placeholder="Enter an image url..." value="<%= d %>assets/banner.png" required>
        <br>
        <hr>
        <br>
        <label for="name">Site Name (embeds / SEO)</label>
        <input type="text" class="form-control themefour text-center defaultborderradius forumcontrol" name="sitename" placeholder="Enter a site name..." value="<%= certain.settings.sitename %>" required>
        <br>
        <label for="name">Site Description (embeds / SEO)</label>
        <textarea name="sitedesc" class="form-control themefour text-center defaultborderradius forumcontrol" placeholder="Enter a site description..." rows="4" required><%= certain.settings.sitedesc %></textarea>
        <br>
        <label for="name">Homepage Description (supports markdown)</label>
        <textarea name="homeabout" class="form-control themefour text-center defaultborderradius forumcontrol" placeholder="Enter a homepage description..." rows="4" required><%= certain.settings.homeabout %></textarea>
        <br>
        <button type="submit" class="btn btn-theme">Save All Changes</button>
    </div>
</form>
<hr>
<h4>Gallery Management</h4>
<p>Add and remove images from the gallery!</p>
<form action="/backend/add/gallery" method="post">
    <div class="form-group">
        <input type="text" class="form-control themefour text-center defaultborderradius forumcontrol" name="imageurl" placeholder="Enter an Image URL..." required>
        <br>
        <button type="submit" class="btn btn-theme">Add Gallery Image</button>
    </div>
</form>
<br>
<div class="customDiv">
    <table class="table table-bordered border-gray text-white">
        <thead>
          <tr>
            <th scope="col">Gallery Image URL</th>
            <th scope="col" class="text-end">Options</th>
          </tr>
        </thead>
        <tbody>
            <% certain.gallery.forEach(function(image) { %>
                <tr>
                    <td><a href="<%= image.link %>" target="_blank"><%= image.link %></a></td>
                    <td class="text-end">
                        <a class="btn btn-outline-danger btn-sm" href="/backend/delete/gallery/<%= image.pass %>">Delete</a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>
<hr>
<h4>Event Management</h4>
<p>Add and remove community events here!</p>
<form action="/backend/add/event" method="post">
    <div class="form-group">
        <input type="text" class="form-control themefour text-center defaultborderradius forumcontrol" name="eventname" placeholder="Enter an event name..." required>
        <br>
        <input type="text" class="form-control themefour text-center defaultborderradius forumcontrol" name="eventlink" placeholder="Enter an event link..." required>
        <br>
        <button type="submit" class="btn btn-theme">Create Event</button>
    </div>
</form>
<br>
<div class="customDiv">
    <table class="table table-bordered border-gray text-white">
        <thead>
          <tr>
            <th scope="col">Event Name</th>
            <th scope="col">Event Link</th>
            <th scope="col" class="text-end">Options</th>
          </tr>
        </thead>
        <tbody>
            <% certain.events.forEach(function(event) { %>
                <tr>
                    <td><%= event.name %></td>
                    <td><a href="<%= event.link %>" target="_blank"><%= event.link %></a></td>
                    <td class="text-end">
                        <a class="btn btn-outline-danger btn-sm" href="/backend/delete/event/<%= event.uniqueid %>">Delete</a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>
<hr>
