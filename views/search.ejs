<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title><%= site.title %> - Search</title>
        <meta property="og:title" content="<%= site.title %> - Search" />
        <link rel="icon" href="/assets/logo.png">
        <meta property="og:image" content="/assets/logo.png">
        <meta name="theme-color" content="<%= site.themetext %>">
        <meta name="description" content="<%= site.description %>" />
        <meta property="og:type" content="website" />
        <meta property="og:description" content="<%= site.description %>" />
    </head>
    <body>
        <%- include('_header') %>
        <div class="container themetwo defaultborderradius text-center" style="padding: 2em;">
            <h2>Users</h2>
            <p>Below you will find all users relating to your search.</p>
            <div class="row justify-content-center">
                <% certain.users.forEach(function(user) { %>
                    <div class="col-auto">
                        <a href="/account/<%= user.userid %>">
                            <div class="themefour searchboxdisplaystuff catborder">
                                <img src="/images/avatar_<%= user.userid %>.png" alt="user avatar" class="searchimage" loading="lazy">
                                <h4><%= user.usertag %></h4>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>
            <br>
            <hr>
            <br>
            <h2>Categories</h2>
            <p>Below you will find all categories relating to your search.</p>
            <div class="row justify-content-center">
                <% certain.cats.forEach(function(cat) { %>
                    <div class="col-auto">
                        <a href="/forums/c/<%= cat.link %>">
                            <div class="themefour searchboxdisplaystuff biggersearch catborder">
                                <img src="<%= cat.imageurl %>" alt="category image" class="searchimage" loading="lazy">
                                <h4><%= cat.name %></h4>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>
            <br>
            <hr>
            <br>
            <h2>Topics</h2>
            <p>Below you will find all topics relating to your search.</p>
            <div class="row justify-content-center">
                <% certain.topics.forEach(function(topic) { %>
                    <div class="col-auto">
                        <a href="/backend/findcatfromform/<%= topic.catid %>/<%= topic.link %>">
                            <div class="themefour searchboxdisplaystuff biggersearch catborder">
                                <img src="/images/avatar_<%= topic.userid %>.png" alt="category image" class="searchimage" loading="lazy">
                                <h4><%= topic.name %></h4>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>
            <br>
        </div>
        <%- include('_footer') %>
    </body>
</html>